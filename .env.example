# Atlas OS — environment variables (keys only; never commit values)
# Validated at boot by src/core/env.ts. See docs/SECURITY.md.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Postgres 17 + pgvector; Neon in preview/production) ---
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable
# Separate role for migrations in CI/CD
DATABASE_MIGRATION_URL=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
ALLOWED_OWNER_EMAILS=          # comma-separated allowlist; registration is closed otherwise

# --- AI providers (server-only; roles mapped in src/core/ai/models.ts) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: route through Vercel AI Gateway instead of direct keys
AI_GATEWAY_API_KEY=

# --- Data encryption (AES-256-GCM, versioned) ---
ATLAS_DATA_KEY_V1=             # openssl rand -base64 32
ATLAS_DATA_KEY_CURRENT=v1

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
SENTRY_DSN=
