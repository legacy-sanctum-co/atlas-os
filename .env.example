# Atlas OS — environment variables (keys only; never commit values)
# Validated at boot by src/core/env.ts. See docs/SECURITY.md.
# Copy to .env.local for development. .env* files are gitignored.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Postgres 17 + pgvector; Neon in preview/production) ---
# Local:  postgres://atlas:atlas@localhost:5432/atlas
# Neon:   postgres://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated allowlist. Registration is closed to everyone else.
# Single-owner system: sign-up is also disabled once the owner exists.
ALLOWED_OWNER_EMAILS=

# --- Data encryption (AES-256-GCM, versioned; see src/core/crypto) ---
ATLAS_DATA_KEY_V1=             # openssl rand -base64 32
ATLAS_DATA_KEY_CURRENT=v1

# --- AI providers (server-only; roles mapped in src/core/ai/models.ts) ---
# Not required until M3. Leave empty in M0/M1.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
